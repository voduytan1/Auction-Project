# ===========================================
# Frontend Environment Variables
# ===========================================
# Copy this file to .env.local and fill in the values

# ===========================================
# Backend API Configuration
# ===========================================
# Backend API URL (default: http://localhost:8080)
VITE_API_URL=http://localhost:8080

# WebSocket URL for real-time updates (default: http://localhost:8080/ws)
VITE_WS_URL=http://localhost:8080/ws

# ===========================================
# Security & Authentication
# ===========================================
# reCAPTCHA v3 Site Key
# Get your site key at: https://www.google.com/recaptcha/admin
# Required for login/register forms to prevent bot attacks
VITE_RECAPTCHA_SITE_KEY=6LfK-jksAAAAAKME8xExIphmKnD9l9HfHlg-x2UV

# ===========================================
# OAuth Providers
# ===========================================
# Google OAuth Client ID
# Get your client ID at: https://console.cloud.google.com/apis/credentials
# Required for "Sign in with Google" functionality
VITE_OAUTH_GOOGLE_CLIENT_ID=718771185039-jf3u9f23pg247ou1kth9gk2o3m920gh0.apps.googleusercontent.com